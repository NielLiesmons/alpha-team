[Unit]
Description=Alpha API (alphamail.xyz)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/alpha-api-alphamail
Environment=ALPHA_API_SITE_URL=https://alphamail.xyz
Environment=ALPHA_API_PUBLIC_URL=https://api.alphamail.xyz
EnvironmentFile=/etc/alpha-api/alphamail.env
ExecStart=/opt/alpha-api/target/release/alpha-api serve --listen 127.0.0.1:8808 --data /opt/alpha-api-alphamail/data
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
